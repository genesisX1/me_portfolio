{
  "name": "joackim-portfolio",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/security-build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "standalone": "node scripts/standalone.mjs",
    "deliver": "npm run typecheck && npm test && npm run build && npm run standalone && npm run test:ui && npm run test:security-output",
    "test:ui": "node tests/interface.integration.mjs",
    "audit:security": "npm audit --audit-level=low",
    "test:security-output": "node tests/security-output.mjs"
  },
  "dependencies": {
    "framer-motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
