{
  "name": "joackim-portfolio",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/security-build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "standalone": "node scripts/standalone.mjs",
    "deliver": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run standalone && npm run test:ui && npm run test:security-output",
    "test:ui": "node tests/interface.integration.mjs",
    "audit:security": "npm audit --audit-level=low",
    "test:security-output": "node tests/security-output.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "lint": "eslint src scripts eslint.config.mjs --max-warnings=0",
    "format": "prettier --write src scripts eslint.config.mjs .prettierrc.json package.json tsconfig.json",
    "format:check": "prettier --check src scripts eslint.config.mjs .prettierrc.json package.json tsconfig.json"
  },
  "dependencies": {
    "framer-motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
